{
  "name": "dsh-code",
  "description": "Terminal coding agent powered by DeepSeek Harness — a thin TUI host over @deepseek-ai/dsh-base",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "deepseek",
    "coding-agent",
    "terminal",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoxiucai/dsh-code.git"
  },
  "homepage": "https://github.com/guoxiucai/dsh-code#readme",
  "bugs": {
    "url": "https://github.com/guoxiucai/dsh-code/issues"
  },
  "bin": {
    "dsh-code": "lib/bin.js"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh-CN.md",
    "docs/assets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-bin-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:lib": "pnpm run build:lib:host && pnpm run build:lib:client",
    "build:lib:host": "cd deepseek-harness && tsc -b tsconfig.host.json && tsdown --env.DSH_BUILD_FACE host",
    "build:lib:client": "cd deepseek-harness && tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "release:pack": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-tarball.mjs",
    "release:smoke": "node scripts/smoke-install.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-settings": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:^",
    "@earendil-works/pi-tui": "0.84.2",
    "diff": "^9.0.0",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-agent-default-model": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-commands": "workspace:^",
    "@deepseek-ai/dsh-compaction": "workspace:^",
    "@deepseek-ai/dsh-llm-retry": "workspace:^",
    "@deepseek-ai/dsh-permission-presets": "workspace:^",
    "@deepseek-ai/dsh-plan-mode": "workspace:^",
    "@deepseek-ai/dsh-session-query": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-token-meter": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@agentclientprotocol/sdk": "0.25.1",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@yarnpkg/cli-dist": "4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "execa": "^10.0.0",
    "fast-check": "^4.8.0",
    "istanbul-lib-report": "^3.0.1",
    "jscpd": "^5.0.12",
    "jsdom": "29.1.1",
    "knip": "^6.16.1",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "^0.3.21",
    "smol-toml": "^1.7.1",
    "spdx-expression-parse": "^5.0.0",
    "tsx": "^4.22.4",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
